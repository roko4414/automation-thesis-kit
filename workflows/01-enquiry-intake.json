        "toEmail": "owner@example.ch",
        "subject": "=SAFETY \u2014 {{ $json.customer_name || 'unknown caller' }} \u2014 call now",
        "emailFormat": "html",
        "html": "=<p><strong>Possible safety emergency. Automated handling stopped.</strong></p><p><strong>Contact:</strong> {{ $json.phone || $json.email || 'NONE SUPPLIED' }}</p><p><strong>They wrote:</strong></p><blockquote>{{ $json.raw }}</blockquote><p>Job {{ $json.job_id }} received {{ $json.created_at }}.</p>",
        "options": {}
      },
