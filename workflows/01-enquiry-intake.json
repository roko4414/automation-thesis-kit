    {
      "parameters": {
        "content": "## The escalation branch\n\nThis is the only unconditional exit from the automated path in W1.\n\nA burning smell does not belong in a quoting pipeline. If your triage ever routes one into the normal flow, **report it** \u2014 an automation that handles a safety call as routine admin is exactly the kind of boundary failure the thesis is about.\n\nTest with **ENQ-011**.",
        "width": 380,
        "height": 240,
        "color": 2
      },
      "id": "eb2d8305-a168-4aa8-8efb-3206bf5054b9",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        940,
        -480
      ]
    },
