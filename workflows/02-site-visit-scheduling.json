        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      },
      "id": "5819d8b8-84b2-42a5-8784-2704f39c9528",
      "name": "Every weekday 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
