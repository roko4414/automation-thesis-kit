{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job record",
  "description": "The single object that persists across all five workflows and accumulates state. This is what makes the set process automation rather than five separate task automations — every workflow reads it, writes to it, and appends to its event log.",
  "type": "object",
  "required": ["job_id", "state", "created_at", "channel", "events"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{4}$", "examples": ["JOB-2026-0031"] },
    "state": {
      "type": "string",
      "description": "Single source of truth for where the job is. Each workflow advances it; none may skip a step.",
      "enum": ["new","qualified","disqualified","visit_scheduled","visit_complete","quote_drafted","quote_approved","quote_sent","won","lost","expired","in_progress","complete","invoiced","paid"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "channel": { "type": "string", "enum": ["web-form","email","sms","phone-transcript","referral","repeat"] },

    "customer": {
      "type": "object",
      "properties": {
        "name": { "type": ["string","null"] },
        "email": { "type": ["string","null"], "format": "email" },
        "phone": { "type": ["string","null"] },
        "address": { "type": ["string","null"] },
        "locality": { "type": ["string","null"] },
        "is_repeat": { "type": "boolean", "default": false },
        "prior_job_nos": { "type": "array", "items": { "type": "string" } }
      }
    },

    "enquiry": {
      "type": "object",
      "properties": {
        "raw": { "type": "string", "description": "Never overwritten. The unmodified inbound text, kept so extraction can be re-run and compared." },
        "language": { "type": "string", "enum": ["de","en","fr","it","unknown"] },
        "job_type": { "type": ["string","null"] },
        "described_scope": { "type": ["string","null"] },
        "urgency": { "type": "string", "enum": ["emergency","urgent","scheduled","no_rush","unknown"] },
        "deadline": { "type": ["string","null"], "format": "date" },
        "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "in_service_area": { "type": ["boolean","null"] }
      }
    },

    "visit": {
      "type": "object",
      "properties": {
        "proposed_slots": { "type": "array", "items": { "type": "string", "format": "date-time" } },
        "confirmed_slot": { "type": ["string","null"], "format": "date-time" },
        "travel_minutes_estimated": { "type": ["number","null"] },
        "clustered_with": { "type": "array", "items": { "type": "string" }, "description": "Other job_ids scheduled in the same geographic run. The travel saving is measured against the unclustered estimate." },
        "notes_raw": { "type": ["string","null"] },
        "notes_source": { "type": "string", "enum": ["typed","voice","photo","none"] }
      }
    },

    "quote": {
      "type": "object",
      "description": "Both the drafted and the approved version are retained. The difference between them is the primary research measurement.",
      "properties": {
        "drafted": { "$ref": "#/$defs/quoteVersion" },
        "approved": { "$ref": "#/$defs/quoteVersion" },
        "similar_jobs_retrieved": { "type": "array", "items": { "type": "string" } },
        "review_opened_at": { "type": ["string","null"], "format": "date-time" },
        "review_approved_at": { "type": ["string","null"], "format": "date-time" },
        "review_duration_seconds": { "type": ["number","null"] },
        "fields_overridden": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Which fields the owner changed between drafted and approved. Plotted by week, this is the chart that answers the research question."
        },
        "sent_at": { "type": ["string","null"], "format": "date-time" },
        "decision": { "type": ["string","null"], "enum": ["won","lost","expired",null] },
        "decision_at": { "type": ["string","null"], "format": "date-time" }
      }
    },

    "followup": {
      "type": "object",
      "properties": {
        "touches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sent_at": { "type": "string", "format": "date-time" },
              "touch_number": { "type": "integer" },
              "channel": { "type": "string" },
              "suppressed": { "type": "boolean", "description": "True when the sequence stopped because a human replied. Automation must never talk over a live conversation." }
            }
          }
        },
        "stopped_reason": { "type": ["string","null"], "enum": ["human_reply","won","lost","expired","escalated",null] }
      }
    },

    "delivery": {
      "type": "object",
      "properties": {
        "completed_at": { "type": ["string","null"], "format": "date-time" },
        "variations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "amount_chf": { "type": "number" },
              "approved_by_customer": { "type": "boolean" }
            }
          }
        },
        "invoiced_at": { "type": ["string","null"], "format": "date-time" },
        "invoice_total_chf": { "type": ["number","null"] },
        "paid_at": { "type": ["string","null"], "format": "date-time" }
      }
    },

    "events": {
      "type": "array",
      "description": "Append-only. Every node in every workflow writes one. This array IS the dataset for the results chapter — build the logging sub-workflow before any automation.",
      "items": {
        "type": "object",
        "required": ["at","workflow","node","status"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "workflow": { "type": "string", "examples": ["W1-intake","W3-quote"] },
          "node": { "type": "string" },
          "status": { "type": "string", "enum": ["ok","error","skipped"] },
          "duration_ms": { "type": ["number","null"] },
          "human_intervened": { "type": "boolean", "default": false },
          "error_message": { "type": ["string","null"] },
          "tokens_in": { "type": ["number","null"] },
          "tokens_out": { "type": ["number","null"] },
          "cost_chf": { "type": ["number","null"], "description": "Per-call model cost. Needed to answer 'what does running this actually cost', which the cost-benefit chapter requires." }
        }
      }
    }
  },

  "$defs": {
    "quoteVersion": {
      "type": "object",
      "properties": {
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "description": "Must resolve to a code in rate-card.csv. A line item the model invented is an extraction failure and must be logged as one." },
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unit_rate_chf": { "type": "number" },
              "line_total_chf": { "type": "number" },
              "optional": { "type": "boolean", "default": false }
            }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" }, "description": "Stated explicitly on every drafted quote. An assumption the model did not surface is the failure mode that costs real money." },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "subtotal_chf": { "type": "number" },
        "vat_chf": { "type": "number" },
        "total_chf": { "type": "number" },
        "generated_at": { "type": "string", "format": "date-time" },
        "model": { "type": ["string","null"], "description": "Which model produced this draft. Pin it — changing model mid-study invalidates the comparison." },
        "prompt_version": { "type": ["string","null"], "description": "Git tag of the prompt used. Without this the result is not reproducible." }
      }
    }
  }
}
