                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "out_of_area"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "disqualified"
        }
      },
