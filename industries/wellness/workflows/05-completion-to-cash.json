        "responseMode": "lastNode",
        "options": {}
      },
      "id": "6f3f37ed-df1a-492c-a58b-a347ba5501cf",
      "name": "Treatment series marked complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -320,
        -100
      ],
      "webhookId": "05fd7889-66c2-4db0-8b57-e8c4b20a09ab"
    },
